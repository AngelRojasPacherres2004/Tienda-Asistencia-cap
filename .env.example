# Copia estas variables en Netlify > Site configuration > Environment variables.
# Nunca uses el prefijo VITE_ para secretos (se enviarían al navegador).

# Panel de Supabase > Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Firma de la sesión (JWT). Genera un valor largo y aleatorio:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=genera-un-secreto-largo-y-aleatorio
