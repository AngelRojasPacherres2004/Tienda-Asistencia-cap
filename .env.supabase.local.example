# Copia este archivo como .env.supabase.local y completa los valores del
# proyecto de Supabase administrado por dashboardcomercialn@gmail.com.
# No compartas ni subas .env.supabase.local, la service_role ni contraseñas.
# Consulta CONFIGURAR_CREDENCIALES_SUPABASE.txt para saber dónde obtener cada valor.

# Project Settings > API
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR_CON_LA_CLAVE_PUBLICABLE

# Project Settings > API > Secret keys. Úsala solo en herramientas administrativas
# autorizadas; el flujo local de Parquet no crea usuarios ni publica información.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REEMPLAZAR_CON_LA_CLAVE_SERVICE_ROLE

# Referencias históricas de publicación: no se usan por los BAT vigentes.
SUPABASE_PUBLISHER_USERNAME=comercial1
# Déjala vacía salvo que un administrador use una herramienta de publicación autorizada.
SUPABASE_PUBLISHER_PASSWORD=
# Conserva la versión vigente y una anterior; acepta valores entre 1 y 3.
DASHBOARD_RELEASES_TO_KEEP=2
# Solo para ejecutar IA local. Nunca se incluye en runtime-config.js ni se publica.
GROQ_API_KEY=REEMPLAZAR_CON_CLAVE_LOCAL
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant
